---
layout: base.njk
pagination:
  data: collections.categories
  size: 1
  alias: cat
permalink: "/blog/c/{{ cat.slug }}/"
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ cat.title }}｜貝森知識文章"
  metaTitle: "{{ cat.title }}相關文章｜貝森國際商務中心"
  description: "{{ cat.intro | truncate(150) }}"
  lineSrc: "seo_c_{{ cat.slug }}"
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": {{ (site.url + page.url) | dump | safe }},
      "name": {{ (cat.title + "相關文章") | dump | safe }},
      "description": {{ cat.intro | dump | safe }},
      "inLanguage": "zh-Hant-TW",
      "isPartOf": { "@id": {{ (site.url + "/#website") | dump | safe }} }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": {{ (site.url + "/") | dump | safe }} },
        { "@type": "ListItem", "position": 2, "name": "知識文章", "item": {{ (site.url + "/blog/") | dump | safe }} },
        { "@type": "ListItem", "position": 3, "name": {{ cat.title | dump | safe }} }
      ]
    },
    {
      "@type": "ItemList",
      "itemListElement": [
        {%- for p in cat.posts %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "url": {{ (site.url + p.url) | dump | safe }},
          "name": {{ p.data.title | dump | safe }}
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
  ]
}
</script>

<div class="art">

  <nav class="crumb" aria-label="麵包屑">
    <a href="/">首頁</a><i>›</i><a href="/blog/">知識文章</a><i>›</i><span>{{ cat.title }}</span>
  </nav>

  <header class="list-head">
    <span class="eyebrow">{{ cat.title }}</span>
    <h1>{{ cat.title }}</h1>
    <p>{{ cat.intro }}</p>
  </header>

  <div class="chips">
    <a href="/blog/" class="chip">全部</a>
    {%- for c in collections.categories %}
    <a href="/blog/c/{{ c.slug }}/" class="chip{% if c.slug == cat.slug %} on{% endif %}">{{ c.title }}<em>{{ c.count }}</em></a>
    {%- endfor %}
  </div>

  <div class="cards">
    {%- for p in cat.posts %}
    <a class="card" href="{{ p.url }}">
      <div class="k">{{ p.data.category }}</div>
      <h3>{{ p.data.title }}</h3>
      <p>{{ p.data.description | truncate(74) }}</p>
      <div class="d">{{ (p.data.updated or p.date) | twDate }}</div>
    </a>
    {%- endfor %}
  </div>

  <section class="cta" style="margin-top:56px">
    <h2>需要有人直接幫你看你的狀況？</h2>
    <p>文章寫的是通則，但每一家公司的情況不一樣。加 LINE 跟我們說你的狀況，我們會誠實告訴你哪一種做法最合適——包含你其實還不需要我們的時候。</p>
    <div class="acts">
      {%- set msg = lineMessages[cat.name] %}
      <a href="/line?src={{ lineSrc }}{% if msg %}&m={{ msg | urlencode }}{% endif %}" target="_blank" rel="noopener" class="btn btn-line">加 LINE 詢問 {{ site.lineId }}</a>
      <a href="/form.html" class="btn btn-ghost">填寫需求表單</a>
    </div>
  </section>

</div>
